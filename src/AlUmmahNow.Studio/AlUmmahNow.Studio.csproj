<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lantern Glass: the owner's lantern-string art and the Fawanees tokens (scripts/sync-fanous.sh). -->
    <EmbeddedResource Include="Assets\lantern-string.png" LogicalName="studio/lantern-string.png" />
    <EmbeddedResource Include="Assets\app-icon.png" LogicalName="studio/app-icon.png" />
    <EmbeddedResource Include="Theme\*.xaml" LogicalName="studio/theme/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Theme\*.css" LogicalName="studio/theme/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\AlUmmahNow.CoreBridge\AlUmmahNow.CoreBridge.csproj" />
    <ProjectReference Include="..\AlUmmahNow.App\AlUmmahNow.App.csproj" />
  </ItemGroup>
</Project>
