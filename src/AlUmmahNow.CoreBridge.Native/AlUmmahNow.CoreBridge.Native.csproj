<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Separate from CoreBridge: the Rust core has no Tizen build. -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CI's update test alone; never in a release (scripts/no-test-hooks.mjs). -->
    <DefineConstants Condition="'$(UpdateTest)' == 'true'">$(DefineConstants);UPDATE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AlUmmahNow.Core" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <ProjectReference Include="..\AlUmmahNow.CoreBridge\AlUmmahNow.CoreBridge.csproj" />
    <EmbeddedResource Include="UpdateKeys\update-keys.json*" LogicalName="%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="AlUmmahNow.CoreBridge.Native.Tests" />
  </ItemGroup>
</Project>
