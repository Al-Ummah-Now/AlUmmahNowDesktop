<!--
  Per-machine MSI for an unpackaged, self-contained WinUI 3 app. Built by .github/workflows/release.yml:
    wix build packaging/windows/app.wxs -arch x64 -d Version=1.2.3 -d PublishDir=... -d ProductName=...
      -d ExeName=... -d InstallDirName=... -d UpgradeCode=... -o out.msi
  Each app keeps its UpgradeCode forever so a newer MSI replaces the older one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.ProductName)" Manufacturer="Al Ummah Now" Version="$(var.Version)" UpgradeCode="$(var.UpgradeCode)" Scope="perMachine" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://alummahnow.net" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallDirName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="$(var.ProductName)">
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)\**" />
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut Id="AppShortcut" Name="$(var.ProductName)" Target="[INSTALLFOLDER]$(var.ExeName)" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\Al Ummah Now\$(var.InstallDirName)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
