<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Filled by scripts/fetch-core.sh from the public AlUmmahNowCore release. -->
    <add key="core-local" value=".nuget-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="core-local">
      <package pattern="AlUmmahNow.Core" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
